msgctxt "field:sale.configuration,sale_exception_margin:"
msgid "Sale exception margin (days)"
msgstr "គម្លាតពេលសម្រាប់ករណីលើកលែងនៃការលក់ (ថ្ងៃ)"

msgctxt "field:sale.sale,ignored_moves:"
msgid "Ignored Moves"
msgstr "ចលនាស្តុកដែលបានមិនអើពើ"

msgctxt "field:sale.sale.revoke.start,manage_invoices:"
msgid "Also Manage Invoices?"
msgstr "គ្រប់គ្រងវិក្កយបត្រផងដែរឬទេ?"

msgctxt "model:ir.action,name:act_sale_create_pending_moves_wizard"
msgid "Create Pending Moves"
msgstr "បង្កើតចលនាស្តុកដែលរង់ចាំ"

msgctxt "model:ir.action,name:wizard_revoke"
msgid "Revoke Sale"
msgstr "ដកហូតការលក់"

#, python-format
msgctxt "model:ir.message,text:msg_can_not_revoke_invoices"
msgid ""
"You cannot revoke \"%(record)s\" because there are invoices that are not in "
"Cancel, Draft, Posted or Paid state: \"%(names)s\"."
msgstr ""
"មិនអាចដកហូត «%(record)s» បានទេ "
"ព្រោះមានវិក្កយបត្រដែលមិនស្ថិតក្នុងស្ថានភាពបានបោះបង់ សេចក្តីព្រាង "
"បានកត់ក្នុងបញ្ជី ឬបានបង់៖ «%(names)s»។"

#, python-format
msgctxt "model:ir.message,text:msg_can_not_revoke_moves"
msgid ""
"You cannot revoke \"%(record)s\" because there are moves that are not in "
"Cancel, Draft or Done state: \"%(names)s\"."
msgstr ""
"មិនអាចដកហូត «%(record)s» បានទេ "
"ព្រោះមានចលនាស្តុកដែលមិនស្ថិតក្នុងស្ថានភាពបានបោះបង់ សេចក្តីព្រាង ឬបានបញ្ចប់៖ "
"«%(names)s»។"

msgctxt "model:ir.model.button,string:sale_create_pending_moves_button"
msgid "Create Pending Moves"
msgstr "បង្កើតចលនាស្តុកដែលរង់ចាំ"

msgctxt "model:ir.model.button,string:sale_revoke_button"
msgid "Revoke"
msgstr "ដកហូត"

msgctxt "model:sale.sale.revoke.start,name:"
msgid "Revoke Start"
msgstr "ចាប់ផ្ដើមដកហូត"

msgctxt "selection:ir.cron,method:"
msgid "Fix Exception Sales"
msgstr "ជួសជុលករណីលើកលែងនៃការលក់"

msgctxt "view:sale.sale.revoke.start:"
msgid "Are you sure you want to revoke sales?"
msgstr "តើអ្នកពិតជាចង់ដកហូតការលក់ឬទេ?"

msgctxt "wizard_button:sale.sale.revoke,start,end:"
msgid "Cancel"
msgstr "បោះបង់"

msgctxt "wizard_button:sale.sale.revoke,start,revoke:"
msgid "Revoke"
msgstr "ដកហូត"

msgctxt "model:ir.model.button,confirm:sale_revoke_button"
msgid "Are you sure you want to revoke sales?"
msgstr "តើអ្នកពិតជាចង់ដកហូតការលក់ឬទេ?"
