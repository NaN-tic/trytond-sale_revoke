#, python-format
msgctxt "model:ir.message,text:msg_can_not_revoke_invoices"
msgid ""
"You cannot revoke \"%(record)s\" because there are invoices that are not in "
"Cancel, Draft, Posted or Paid state: \"%(names)s\"."
msgstr "无法撤销“%(record)s”，因为存在状态不为“已取消”“草稿”“已过账”或“已付款”的发票：“%(names)s”。"

#, python-format
msgctxt "model:ir.message,text:msg_can_not_revoke_moves"
msgid ""
"You cannot revoke \"%(record)s\" because there are moves that are not in "
"Cancel, Draft or Done state: \"%(names)s\"."
msgstr "无法撤销“%(record)s”，因为存在状态不为“已取消”“草稿”或“已完成”的移动：“%(names)s”。"

